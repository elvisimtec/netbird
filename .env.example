# NetBird Server SSH Connection
# Format: SSH config style
# 
# Copy this file to .env and fill in your values.
# .env is git-ignored and should NEVER be committed.

Host netbird
    HostName <server-ip-address>
    User <ssh-username>
    Port <ssh-port>
    IdentityFile <path-to-ssh-private-key>
    IdentitiesOnly yes

# Sudo password for the server (if required)
sudo: <sudo-password>

# NetBird Dashboard
dashboard_url: <dashboard-url>
dashboard_admin_email: <admin-email>
dashboard_admin_password: <admin-password>

# Komodo Server Management
komodo_core_url: <komodo-core-url>
# Periphery ONBOARDING key (server -> Core), NOT a Komodo Core API key
komodo_onboarding_key: <komodo-onboarding-key>
